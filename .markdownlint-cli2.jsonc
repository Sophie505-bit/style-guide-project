{
  // Конфигурация markdownlint-cli2 для русскоязычной документации.
  "config": {
    // Длина строки не ограничена: переносы не влияют на отображение.
    "MD013": false,
    // Дубли заголовков допускаются только в разных родительских разделах.
    "MD024": { "siblings_only": true },
    // Встроенный HTML разрешён (нужен для MkDocs Material).
    "MD033": false,
    // Жирный текст как «псевдозаголовок» допустим в примерах.
    "MD036": false,
    // Блоки примечаний MkDocs (!!! note) требуют отступов, поэтому
    // проверка стиля блоков кода отключена.
    "MD046": false
  },
  "overrides": [
    {
      // Шаблон Pull Request начинается с заголовка второго уровня.
      "files": [".github/**/*.md"],
      "config": { "MD041": false }
    },
    {
      // Главная страница начинается с HTML-блока «герой».
      "files": ["docs/index.md"],
      "config": { "MD041": false }
    }
  ],
  "globs": ["docs/**/*.md", "*.md", ".github/**/*.md"],
  "ignores": ["site/**", "node_modules/**"]
}
